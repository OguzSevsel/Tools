:root {
}

.flexGrow {
    flex-grow: 1;
}

.unity-tab__header {
    align-self: stretch;
    align-items: stretch;
    justify-content: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(79, 79, 79);
    border-right-color: rgb(79, 79, 79);
    border-top-color: rgb(79, 79, 79);
    border-bottom-color: rgb(79, 79, 79);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0%;
}

.unity-tab-view__header-container {
    flex-grow: 1;
    align-content: center;
    justify-content: center;
}

.unity-tab-view__content-container {
    flex-grow: 1;
}

.unity-tab__content-container {
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.unity-text-field__label {
    -unity-text-auto-size: best-fit 10px 14px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 10px;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: upper-right;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.unity-object-field__label {
    -unity-text-auto-size: best-fit 10px 14px;
    -unity-text-align: upper-right;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 10px;
    padding-bottom: 0;
    padding-left: 0;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.unity-object-field-display__label--value-null {
    -unity-text-auto-size: best-fit 10px 14px;
}

.unity-text-element--inner-input-field-component {
    -unity-text-auto-size: best-fit 10px 14px;
    text-overflow: ellipsis;
}

.unity-base-text-field__input--multiline {
    height: 100px;
    min-height: 50px;
    max-height: 150px;
    text-overflow: ellipsis;
}

.height50 {
    height: 50px;
    min-height: 50px;
    max-height: 50px;
}

.sideBar {
    flex-grow: 1;
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 5px;
}

.unity-tab {
    flex-grow: 1;
}

.title {
    -unity-text-align: middle-center;
    -unity-text-auto-size: best-fit 5px 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    min-height: 40px;
    min-width: 40px;
}

.unity-tab__header > .unity-tab__header-label {
    -unity-text-auto-size: best-fit 10px 20px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.CreateButton {
    -unity-text-auto-size: best-fit 10px 30px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 3px;
    word-spacing: 10px;
    background-color: rgb(55, 55, 55);
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 80px;
    height: 80px;
}

.Border {
    border-left-color: rgba(0, 0, 0, 0.2);
    border-right-color: rgba(0, 0, 0, 0.2);
    border-top-color: rgba(0, 0, 0, 0.2);
    border-bottom-color: rgba(0, 0, 0, 0.2);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.Background {
    background-color: rgb(55, 55, 55);
}

.CreateButton:hover {
    background-color: rgb(72, 72, 72);
    transition-property: width, height;
    transition-duration: 0.5s, 0.5s;
    transition-timing-function: ease, ease;
    transition-delay: 0s, 0s;
    scale: 1.04 1.04 1.04;
}

.CreateButton:active {
    background-color: rgb(96, 96, 96);
    scale: 1 1;
    transition-property: width, height;
    transition-duration: 0.5s, 0.5s;
}

.Spacing {
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.Size {
    width: 465px;
    min-width: 465px;
    max-width: 465px;
    height: 400px;
    min-height: 400px;
    max-height: 400px;
}

.unity-button {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.dialogButton {
    width: 200px;
    height: 200px;
    min-width: 200px;
    max-width: 200px;
    max-height: 200px;
    min-height: 200px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgb(84, 84, 84);
    text-overflow: clip;
    letter-spacing: 5px;
    word-spacing: 10px;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.dialogButton:hover {
    width: 200px;
    height: 200px;
    min-width: 200px;
    max-width: 200px;
    max-height: 200px;
    min-height: 200px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgb(96, 96, 96);
    text-overflow: clip;
    letter-spacing: 5px;
    word-spacing: 10px;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    transition-property: width, height;
    transition-duration: 0.5s, 0.5s;
    transition-timing-function: ease, ease;
    transition-delay: 0s, 0s;
    scale: 1.04 1.04 1.04;
}

.dialogButton:active {
    width: 200px;
    height: 200px;
    min-width: 200px;
    max-width: 200px;
    max-height: 200px;
    min-height: 200px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgb(101, 101, 101);
    text-overflow: clip;
    letter-spacing: 5px;
    word-spacing: 10px;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    transition-property: width, height;
    transition-duration: 0.5s, 0.5s;
    scale: 1 1;
}
