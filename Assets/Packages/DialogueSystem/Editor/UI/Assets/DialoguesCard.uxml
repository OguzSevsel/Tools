<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Packages/DialogueSystem/Editor/UI/Assets/DialogueSystem.uss?fileID=7433441132597879392&amp;guid=d8ee67fa447200445a0b5eb322156409&amp;type=3#DialogueSystem"/>
    <ui:VisualElement name="DialogueCard" class="flexGrow" style="justify-content: space-evenly; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; align-self: center; align-content: center; align-items: stretch; width: 470px; height: 400px; min-width: 470px; min-height: 400px; max-width: 470px; max-height: 400px; background-color: rgb(55, 55, 55); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgba(0, 0, 0, 0.2); border-right-color: rgba(0, 0, 0, 0.2); border-top-color: rgba(0, 0, 0, 0.2); border-bottom-color: rgba(0, 0, 0, 0.2); padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
        <ui:Image source="project://database/Assets/Packages/TweenSystem/Editor/Icons/Dialogue%20Icon.png?fileID=-8517403982403505446&amp;guid=8f5d79f7a660514428c673a83bdab549&amp;type=3#Dialogue Icon_0" name="DialogueImage" style="position: absolute; width: 40px; height: 40px; top: 3px; left: 3px;"/>
        <ui:Button name="DeleteButton" icon-image="project://database/Assets/Editor%20Default%20Resources/Icons/delete.png?fileID=2800000&amp;guid=36090787d5284da4abab0c041d0af4f6&amp;type=3#delete" style="position: absolute; right: 0; top: 2px; width: 40px; height: 40px;"/>
        <ui:Label class="title">
            <Bindings>
                <ui:DataBinding property="text" data-source-type="Tools.DialogueSystem.Data.DSDialogueText, Tools.DialogueSystem.Editor" data-source-path="_Title_k__BackingField" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:TextField label="Name" name="DialogueName">
            <Bindings>
                <ui:DataBinding property="value" data-source-type="Tools.DialogueSystem.Data.DSDialogueText, Tools.DialogueSystem.Editor" data-source-path="_Title_k__BackingField" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:TextField name="DialogueDescription" label="Description" placeholder-text="Description" multiline="true">
            <Bindings>
                <ui:DataBinding property="value" data-source-type="Tools.DialogueSystem.Data.DSDialogueText, Tools.DialogueSystem.Editor" data-source-path="_Description_k__BackingField" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:TextField name="DialogueText" placeholder-text="Text" multiline="true" label="Text">
            <Bindings>
                <ui:DataBinding property="value" data-source-type="Tools.DialogueSystem.Data.DSDialogueText, Tools.DialogueSystem.Editor" data-source-path="Text" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
    </ui:VisualElement>
</ui:UXML>
