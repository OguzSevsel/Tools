.Button {
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Tools/UI%20System/Resources/Example/Font/Font.ttf?fileID=12800000&guid=379a0f964e6e47048b3ac21b3f16df9c&type=3#Font");
    background-color: rgb(11, 12, 13);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(107, 100, 89);
    border-right-color: rgb(107, 100, 89);
    border-top-color: rgb(107, 100, 89);
    border-bottom-color: rgb(107, 100, 89);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.FoldOut {
    background-color: rgb(11, 12, 13);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(107, 100, 89);
    border-right-color: rgb(107, 100, 89);
    border-top-color: rgb(107, 100, 89);
    border-bottom-color: rgb(107, 100, 89);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Tools/UI%20System/Resources/Example/Font/Font.ttf?fileID=12800000&guid=379a0f964e6e47048b3ac21b3f16df9c&type=3#Font");
    color: rgb(223, 220, 216);
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.FoldOut > .unity-foldout__toggle > .unity-foldout__input > #unity-checkmark {
    background-size: 200% 150%;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}



.Button:hover {
    scale: 1.1 1.1;
}

.Toggle {
    background-color: rgb(22, 23, 24);
    color: rgb(223, 220, 216);
    -unity-font-definition: url("project://database/Assets/Tools/UI%20System/Resources/Example/Font/Font.ttf?fileID=12800000&guid=379a0f964e6e47048b3ac21b3f16df9c&type=3#Font");
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
    -unity-font-style: bold;
    font-size: 12px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    -unity-text-align: middle-center;
    flex-grow: 1;
    height: 40px;
}

.Toggle > .unity-toggle__input > #unity-checkmark {
    background-color: rgb(223, 220, 216);
    width: 30px;
    height: 100%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(107, 100, 89);
    border-right-color: rgb(107, 100, 89);
    border-top-color: rgb(107, 100, 89);
    border-bottom-color: rgb(107, 100, 89);
    min-width: 5%;
    max-width: 30%;
}

.Toggle > .unity-toggle__input {
    justify-content: center;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(107, 100, 89);
    border-right-color: rgb(107, 100, 89);
    border-top-color: rgb(107, 100, 89);
    border-bottom-color: rgb(107, 100, 89);
}

.Enum {
    background-color: rgb(22, 23, 24);
    color: rgb(223, 220, 216);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/Tools/UI%20System/Resources/Example/Font/Font.ttf?fileID=12800000&guid=379a0f964e6e47048b3ac21b3f16df9c&type=3#Font");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    flex-grow: 1;
    height: 40px;
}

.Enum > .unity-enum-field__input {
    background-color: rgb(22, 23, 24);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    border-left-color: rgb(107, 100, 89);
    border-right-color: rgb(107, 100, 89);
    border-top-color: rgb(107, 100, 89);
    border-bottom-color: rgb(107, 100, 89);
    height: 100%;
}

.Enum > .unity-enum-field__input > .unity-enum-field__text {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Tools/UI%20System/Resources/Example/Font/Font.ttf?fileID=12800000&guid=379a0f964e6e47048b3ac21b3f16df9c&type=3#Font");
    -unity-font-style: bold;
    height: 100%;
}

.Enum > .unity-enum-field__input > .unity-enum-field__arrow {
    -unity-background-image-tint-color: rgb(223, 220, 216);
}

