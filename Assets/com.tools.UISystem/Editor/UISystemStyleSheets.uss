.unity-vector3-field__label {
    width: 30%;
    min-width: 10%;
    max-width: 50%;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.unity-enum-field__label {
    width: 30%;
    min-width: 10%;
    max-width: 50%;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

