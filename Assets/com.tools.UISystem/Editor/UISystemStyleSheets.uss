    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(107, 100, 89);
    border-right-color: rgb(107, 100, 89);
    border-top-color: rgb(107, 100, 89);
    border-bottom-color: rgb(107, 100, 89);
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.Vector3 > .unity-vector3-field__input > #unity-x-input {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.Vector3 > .unity-vector3-field__input > #unity-y-input {
