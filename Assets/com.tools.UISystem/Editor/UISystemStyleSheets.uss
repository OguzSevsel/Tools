.Vector3 {
    color: rgb(223, 220, 216);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Tools/UI%20System/Resources/Example/Font/Font.ttf?fileID=12800000&guid=379a0f964e6e47048b3ac21b3f16df9c&type=3#Font");
    -unity-text-align: middle-center;
    background-color: rgb(22, 23, 24);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    flex-grow: 1;
    height: 40px;
}

.Vector3 > .unity-vector3-field__input {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
